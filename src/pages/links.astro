---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import linksData from '../data/links.json';

const friendLinkIssueUrl = 'https://github.com/xrlfreedom233/blog/issues/new?title=%E5%8F%8B%E9%93%BE%E7%94%B3%E8%AF%B7&body=%23%23%20%E5%8F%8B%E9%93%BE%E7%94%B3%E8%AF%B7%0A%0A-%20%E7%AB%99%E7%82%B9%E5%90%8D%E7%A7%B0%EF%BC%9A%0A-%20%E7%AB%99%E7%82%B9%E5%9C%B0%E5%9D%80%EF%BC%9A%0A-%20%E5%A4%B4%E5%83%8F%E5%9C%B0%E5%9D%80%EF%BC%9A%0A-%20%E7%AB%99%E7%82%B9%E7%AE%80%E4%BB%8B%EF%BC%9A';
---

<BaseLayout title="友情链接 | freedom">
	<Header />
	<Hero title="友情链接" subtitle="遇事不决，可问春风；择友而交，亦是幸事。" />
	
	<main class="container mx-auto px-4 py-16 max-w-6xl">
		<div class="space-y-16">
			{linksData.map(group => (
				<div>
					<h2 class="text-2xl font-bold mb-8 dark:text-white flex items-center gap-2">
						<span class="w-1 h-8 bg-primary rounded-full"></span>
						{group.group}
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{group.links.map(link => (
							<a 
								href={link.url} 
								target="_blank"
								class="flex items-center p-4 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 hover:shadow-xl hover:scale-[1.02] transition-all duration-300 group"
							>
								<img src={link.avatar} alt={link.name} class="w-16 h-16 rounded-xl object-cover mr-4" />
								<div class="flex-1 overflow-hidden">
									<h3 class="font-bold text-gray-800 dark:text-white group-hover:text-primary transition-colors">{link.name}</h3>
									<p class="text-base text-gray-500 dark:text-gray-400 truncate">{link.description}</p>
								</div>
							</a>
						))}
					</div>
				</div>
			))}

			<section class="rounded-2xl border border-border-base bg-base-100 p-6 shadow-sm">
				<div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
					<div>
						<h2 class="text-2xl font-bold dark:text-white">申请友链</h2>
						<p class="mt-3 max-w-2xl text-base leading-7 text-text-muted">
							暂时没有评论系统，可以通过 GitHub Issue 提交申请。申请时请带上站点名称、链接、头像和一句简介。
						</p>
					</div>
					<a
						href={friendLinkIssueUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex shrink-0 items-center justify-center rounded-lg bg-primary px-5 py-3 text-base font-bold text-white transition-all hover:bg-primary-hover"
					>
						提交友链申请
					</a>
				</div>
				<div class="mt-5 grid gap-3 text-base text-text-muted md:grid-cols-2">
					<div class="rounded-lg bg-base-200/60 p-4">
						<span class="font-bold text-text-base">站点名称：</span>freedom
					</div>
					<div class="rounded-lg bg-base-200/60 p-4">
						<span class="font-bold text-text-base">站点地址：</span>https://blog.xrlfreedom.top
					</div>
					<div class="rounded-lg bg-base-200/60 p-4">
						<span class="font-bold text-text-base">头像地址：</span>请提供可公网访问的图片链接
					</div>
					<div class="rounded-lg bg-base-200/60 p-4">
						<span class="font-bold text-text-base">站点简介：</span>一句话描述即可
					</div>
				</div>
			</section>
		</div>
	</main>

	<Footer />
</BaseLayout>

---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Ripple from '../../components/common/Ripple.astro';
import AuthorCard from '../../components/sidebar/AuthorCard.astro';
import PopularPosts from '../../components/sidebar/PopularPosts.astro';
import Categories from '../../components/sidebar/Categories.astro';
import Tags from '../../components/sidebar/Tags.astro';
import readingTime from 'reading-time';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, updatedDate, heroImage, tags, categories } = post.data;
const stats = readingTime(post.body);
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentPostIndex = allPosts.findIndex((item) => item.slug === post.slug);
const newerPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : undefined;
const olderPost = currentPostIndex >= 0 && currentPostIndex < allPosts.length - 1 ? allPosts[currentPostIndex + 1] : undefined;
const showUpdatedDate = updatedDate && updatedDate.valueOf() !== pubDate.valueOf();
---

<BaseLayout title={`${title} | freedom`} description={description}>
	<Header />
	
	<!-- 找回的大图区域 (Post Hero) -->
	<!-- bg-[#3f4936]：hero 大图尚未绘制时的占位底色，避免首屏未加载完成时白屏闪烁。 -->
	<section transition:name={`post-${post.slug}`} class="relative h-[50vh] min-h-[400px] w-full overflow-hidden flex items-center justify-center bg-[#3f4936] dark:bg-[#2b3126]">
		<div class="absolute inset-0 z-0">
			<!-- 不使用 transition-all，避免页面切入时图片 brightness 渐变导致上层标签出现闪烁 -->
			<img 
				src={heroImage || "/images/imbg.avif"} 
				alt={title} 
				width="1600"
				height="900"
				fetchpriority="high"
				decoding="sync"
				class="h-full w-full object-cover brightness-[0.6] dark:brightness-[0.4]"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-base-100"></div>
		</div>

		<!-- 文字内容 -->
		<div class="relative z-10 text-center px-4 max-w-4xl">
			<div class="flex flex-wrap justify-center gap-2 mb-6">
				{categories && categories.map(cat => (
					<a href={`/categories/${cat}/`} class="px-4 py-1.5 bg-primary text-white rounded-full text-base font-black uppercase tracking-wider shadow-lg">
						{cat}
					</a>
				))}
				{tags && tags.map(tag => (
					<a href={`/tags/${tag}/`} class="px-4 py-1.5 bg-white/20 hover:bg-white/30 rounded-full text-base font-black text-white uppercase tracking-wider border border-white/30 transition-colors">
						#{tag}
					</a>
				))}
			</div>
			<h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight drop-shadow-lg leading-tight">
				{title}
			</h1>
			<div class="flex items-center justify-center text-white/90 text-base gap-4 drop-shadow-md">
				<span>📅 {pubDate.toLocaleDateString('zh-CN')}</span>
				{showUpdatedDate && (
					<>
						<span class="w-1.5 h-1.5 bg-white/50 rounded-full"></span>
						<span>更新于 {updatedDate.toLocaleDateString('zh-CN')}</span>
					</>
				)}
				<span class="w-1.5 h-1.5 bg-white/50 rounded-full"></span>
				<span>⏱️ {Math.ceil(stats.minutes)} 分钟阅读</span>
			</div>
		</div>

		<!-- 底部波浪衔接 -->
		<div class="absolute bottom-0 left-0 w-full z-10">
			<Ripple />
		</div>
	</section>

	<!-- 修改后的正文区域：使用 mx-auto 和 max-w 确保居中 -->
	<main class="home-surface min-h-screen">
		<div class="container mx-auto px-4 py-16 max-w-[1520px]">
		<div class="flex flex-col lg:flex-row gap-8 justify-end">
			
			<!-- Article Content (专注阅读宽度) -->
			<aside class="hidden lg:block w-64 shrink-0 space-y-10">
				<AuthorCard />
				<Categories />
				<PopularPosts />
				<Tags />
			</aside>

			<article class="w-full min-w-0 flex-1 lg:max-w-[880px]">
				<div id="articleContentId" class="article-content prose prose-xl dark:prose-invert max-w-none bg-base-100/80 backdrop-blur-sm rounded-2xl border border-border-base shadow-sm prose-headings:scroll-mt-24 prose-img:rounded-2xl prose-pre:bg-gray-900 dark:prose-pre:bg-black/50">
					<Content />
				</div>

				<nav class="mt-14 grid gap-4 border-t border-border-base/60 pt-8 md:grid-cols-2">
					{olderPost ? (
						<a href={`/blog/${olderPost.slug}/`} class="group rounded-xl border border-border-base bg-base-100 p-5 transition-all hover:-translate-y-1 hover:border-primary hover:shadow-md no-underline">
							<span class="text-sm font-bold text-text-muted">上一篇</span>
							<h2 class="mt-2 line-clamp-2 text-xl font-black text-text-base transition-colors group-hover:text-primary">
								{olderPost.data.title}
							</h2>
						</a>
					) : (
						<div class="rounded-xl border border-border-base/60 bg-base-200/40 p-5 text-text-muted">
							<span class="text-sm font-bold">上一篇</span>
							<p class="mt-2">已经是第一篇文章了</p>
						</div>
					)}

					{newerPost ? (
						<a href={`/blog/${newerPost.slug}/`} class="group rounded-xl border border-border-base bg-base-100 p-5 text-right transition-all hover:-translate-y-1 hover:border-primary hover:shadow-md no-underline">
							<span class="text-sm font-bold text-text-muted">下一篇</span>
							<h2 class="mt-2 line-clamp-2 text-xl font-black text-text-base transition-colors group-hover:text-primary">
								{newerPost.data.title}
							</h2>
						</a>
					) : (
						<div class="rounded-xl border border-border-base/60 bg-base-200/40 p-5 text-right text-text-muted">
							<span class="text-sm font-bold">下一篇</span>
							<p class="mt-2">已经是最新文章了</p>
						</div>
					)}
				</nav>
			</article>

			<!-- TOC Sidebar (右侧悬浮) -->
			<aside class="hidden xl:block w-56 shrink-0">
				<div class="sticky top-24" x-data="{ 
					catalog: [], 
					activeIndex: -1,
					init() {
						this.buildCatalog();
						window.addEventListener('scroll', () => this.updateActiveHeading());
					},
					buildCatalog() {
						const headings = Array.from(document.querySelectorAll('#articleContentId h1, #articleContentId h2, #articleContentId h3'));
						this.catalog = headings.map(h => ({
							text: h.textContent,
							id: h.id || (h.id = h.textContent.toLowerCase().replace(/\s+/g, '-')),
							level: parseInt(h.tagName[1])
						}));
					},
					updateActiveHeading() {
						const headings = document.querySelectorAll('#articleContentId h1, #articleContentId h2, #articleContentId h3');
						let currentId = '';
						headings.forEach(h => {
							const top = h.getBoundingClientRect().top;
							if (top < 150) currentId = h.id;
						});
						this.activeIndex = this.catalog.findIndex(c => c.id === currentId);
					}
				}" x-init="init()">
					<div class="bg-base-100 p-5 rounded-2xl shadow-sm border border-border-base">
						<h3 class="mb-4 flex items-center gap-2 text-lg font-bold dark:text-white">
							<span class="icon-[tabler--bookmark] w-5 h-5 text-primary"></span>
							目录
						</h3>
						<nav class="max-h-[70vh] space-y-1 overflow-y-auto pr-1 custom-scrollbar">
							<template x-for="(item, index) in catalog" :key="index">
								<a
									:href="'#' + item.id"
									class="group flex items-start gap-3 rounded-xl px-2 py-2 no-underline transition-colors"
									:class="activeIndex === index ? 'bg-primary/10 text-primary-ink' : 'text-text-muted hover:bg-primary/5 hover:text-primary'"
								>
									<span class="mt-px flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg bg-primary text-xs font-bold text-white">
										<span x-text="index + 1"></span>
									</span>
									<span class="text-sm leading-snug" x-text="item.text"></span>
								</a>
							</template>
						</nav>
					</div>
				</div>
			</aside>
		</div>
		</div>
	</main>

	<Footer />
</BaseLayout>

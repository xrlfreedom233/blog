---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import PopularPosts from '../components/sidebar/PopularPosts.astro';
import AuthorCard from '../components/sidebar/AuthorCard.astro';
import Categories from '../components/sidebar/Categories.astro';
import Tags from '../components/sidebar/Tags.astro';
import Pagination from '../components/common/Pagination.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 8;

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentPage = 1;
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const pagePosts = posts.slice(0, PAGE_SIZE);
const getPageHref = (page: number) => page === 1 ? '/' : `/page/${page}/`;

---

<BaseLayout title="首页 | freedom">
	<Header />
	
		<main class="home-surface min-h-screen">
			<Hero />
			
			<div class="relative z-[1] max-w-7xl mx-auto px-4 md:px-10 py-12">
			<div class="flex flex-col lg:flex-row-reverse gap-10">
				
				<!-- 右侧文章区 -->
				<div class="w-full lg:w-3/4 flex flex-col gap-5">
					{pagePosts.map((post, index) => (
						<div class="animate-fade-in-up" style={`animation-delay: ${Math.min(index * 40, 240)}ms`}>
							<PostCard post={post} />
						</div>
					))}
					<Pagination currentPage={currentPage} totalPages={totalPages} getPageHref={getPageHref} />
				</div>

				<!-- 左侧侧边栏 (极简稳定版) -->
				<aside class="w-full lg:w-1/4">
					<div class="flex flex-col space-y-12">
						
						<!-- 1. 作者卡片 -->
						<AuthorCard />

						<!-- 2. 分类列表 -->
						<Categories />

						<!-- 3. 热门精选 -->
						<PopularPosts />

						<!-- 4. 话题标签 -->
						<Tags />
						</div>

					</div>
				</aside>

			</div>
		</div>
	</main>

	<Footer />
</BaseLayout>

	<style>
		@keyframes spin-slow {
			from { transform: rotate(0deg); }
			to { transform: rotate(360deg); }
	}
	.animate-spin-slow {
		animation: spin-slow 12s linear infinite;
	}
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import Hero from '../../../components/Hero.astro';
import AuthorCard from '../../../components/sidebar/AuthorCard.astro';
import PopularPosts from '../../../components/sidebar/PopularPosts.astro';
import Pagination from '../../../components/common/Pagination.astro';

const PAGE_SIZE = 8;

export async function getStaticPaths() {
	const pageSize = 8;
	const allPosts = await getCollection('blog');
	const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

	return uniqueTags.flatMap((tag) => {
		const filteredPosts = allPosts
			.filter((post) => post.data.tags?.includes(tag))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		const totalPages = Math.ceil(filteredPosts.length / pageSize);

		return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
			const page = index + 2;
			return {
				params: { tag, page: String(page) },
				props: { posts: filteredPosts, currentPage: page, totalPages },
			};
		});
	});
}

const { tag } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const pagePosts = posts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
const getPageHref = (page: number) => page === 1 ? `/tags/${tag}` : `/tags/${tag}/${page}/`;

const allPosts = await getCollection('blog');
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))].slice(0, 10);
---

<BaseLayout title={`标签: ${tag} - 第 ${currentPage} 页 | freedom`}>
	<Header />
	<Hero title={`# ${tag}`} subtitle={`该标签下共有 ${posts.length} 篇文章`} />
	
	<main class="container mx-auto px-4 py-16">
		<div class="flex flex-col lg:flex-row-reverse gap-12">
			<div class="w-full lg:w-3/4">
					<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
					{pagePosts.map((post, index) => (
						<div class="animate-fade-in-up opacity-0" style={`animation-delay: ${index * 100}ms`}>
							<PostCard post={post} />
						</div>
					))}
				</div>
				<Pagination currentPage={currentPage} totalPages={totalPages} getPageHref={getPageHref} />
			</div>

			<aside class="w-full lg:w-1/4 space-y-12">
				<AuthorCard />
				<section class="px-2 animate-fade-in">
						<h3 class="text-base font-black text-text-muted/60 uppercase tracking-[0.24em] mb-6 flex items-center gap-3">
						<span class="w-8 h-[1px] bg-border-base/50"></span>
						Tags
					</h3>
					<div class="flex flex-wrap gap-2">
						{allTags.map(t => (
								<a href={`/tags/${t}`} class={`px-3 py-1.5 text-base font-bold rounded-lg transition-all ${t === tag ? 'bg-primary text-white' : 'bg-base-200/50 text-text-muted/60 hover:text-primary'}`}>
								#{t}
							</a>
						))}
					</div>
				</section>
				<PopularPosts />
			</aside>
		</div>
	</main>
	<Footer />
</BaseLayout>

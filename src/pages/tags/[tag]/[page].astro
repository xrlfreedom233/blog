---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import Hero from '../../../components/Hero.astro';
import AuthorCard from '../../../components/sidebar/AuthorCard.astro';
import PopularPosts from '../../../components/sidebar/PopularPosts.astro';
import Pagination from '../../../components/common/Pagination.astro';

const PAGE_SIZE = 8;

export async function getStaticPaths() {
	const pageSize = 8;
	const allPosts = await getCollection('blog');
	const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

	return uniqueTags.flatMap((tag) => {
		const filteredPosts = allPosts
			.filter((post) => post.data.tags?.includes(tag))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		const totalPages = Math.ceil(filteredPosts.length / pageSize);

		return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
			const page = index + 2;
			return {
				params: { tag, page: String(page) },
				props: { posts: filteredPosts, currentPage: page, totalPages },
			};
		});
	});
}

const { tag } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const pagePosts = posts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
const getPageHref = (page: number) => page === 1 ? `/tags/${tag}/` : `/tags/${tag}/${page}/`;

const allPosts = await getCollection('blog');
const allTagsBase = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
const allTagsTop = allTagsBase.slice(0, 10);
// 保证当前标签始终在列表里，以便高亮显示
const allTags = allTagsTop.includes(tag) ? allTagsTop : [tag, ...allTagsBase.slice(0, 9)];
---

<BaseLayout title={`标签: ${tag} - 第 ${currentPage} 页 | freedom`}>
	<Header />
	<Hero title={`# ${tag}`} subtitle={`该标签下共有 ${posts.length} 篇文章`} />
	
	<main class="container mx-auto px-4 py-16">
		<div class="flex flex-col lg:flex-row-reverse gap-12">
			<div class="w-full lg:w-3/4">
					<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
					{pagePosts.map((post, index) => (
						<div class="animate-fade-in-up opacity-0" style={`animation-delay: ${index * 100}ms`}>
							<PostCard post={post} />
						</div>
					))}
				</div>
				<Pagination currentPage={currentPage} totalPages={totalPages} getPageHref={getPageHref} />
			</div>

			<aside class="w-full lg:w-1/4 space-y-12">
				<AuthorCard />
				<section class="bg-base-100 p-6 rounded-2xl shadow-sm border border-border-base animate-fade-in">
  <h3 class="text-xl font-bold mb-4 dark:text-white flex items-center gap-2">
    <span class="icon-[tabler--hash] w-5 h-5 text-rose-400"></span>
    Tags
  </h3>
  <div class="flex flex-wrap gap-2">
    {allTags.map(t => (
      <a href={`/tags/${t}/`} class={`rounded-full border px-3 py-1 text-sm font-semibold no-underline transition-all hover:-translate-y-0.5 ${t === tag ? 'border-primary bg-primary text-white' : 'border-border-base bg-base-200 text-text-muted hover:border-primary hover:bg-primary hover:text-white'}`}>
        #{t}
      </a>
    ))}
  </div>
</section>
				<PopularPosts />
			</aside>
		</div>
	</main>
	<Footer />
</BaseLayout>

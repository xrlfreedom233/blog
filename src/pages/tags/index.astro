---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allPosts = await getCollection('blog');
const tags = allPosts.reduce((acc, post) => {
  post.data.tags?.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const tagList = Object.entries(tags).sort((a, b) => b[1] - a[1]);
const maxTagCount = Math.max(...tagList.map(([, count]) => count), 1);
const minTagCount = Math.min(...tagList.map(([, count]) => count), 1);
const getTagSize = (count: number) => {
  if (maxTagCount === minTagCount) return 22;
  return Math.round(16 + ((count - minTagCount) / (maxTagCount - minTagCount)) * 20);
};

const ringSizes: number[] = [];
let remainingTags = Math.max(tagList.length - 1, 0);
let ringCapacity = 8;

while (remainingTags > 0) {
  const currentRingSize = Math.min(ringCapacity, remainingTags);
  ringSizes.push(currentRingSize);
  remainingTags -= currentRingSize;
  ringCapacity += 8;
}

const tagCloud = tagList.map(([name, count], index) => {
  if (index === 0) {
    return { name, count, size: getTagSize(count) + 14, x: 50, y: 50, delay: 0 };
  }

  let positionInRing = index - 1;
  let ringIndex = 0;

  while (positionInRing >= ringSizes[ringIndex]) {
    positionInRing -= ringSizes[ringIndex];
    ringIndex += 1;
  }

  const ringSize = ringSizes[ringIndex];
  const angleStep = 360 / ringSize;
  const angle = -90 + positionInRing * angleStep + (ringIndex % 2 === 0 ? 0 : angleStep / 2);
  const radius = ringSizes.length === 1
    ? 34
    : 18 + (ringIndex / Math.max(ringSizes.length - 1, 1)) * 26;
  const radians = angle * Math.PI / 180;

  return {
    name,
    count,
    size: getTagSize(count),
    x: 50 + Math.cos(radians) * radius,
    y: 50 + Math.sin(radians) * radius,
    delay: index * 40,
  };
});
---

<BaseLayout title="全部标签 | freedom">
  <Header />

  <main class="relative flex min-h-screen flex-col overflow-hidden bg-base-100 px-4 pb-8 pt-24">
    <div class="absolute inset-x-0 top-0 h-72 overflow-hidden">
      <img
        src="/images/imbg.avif"
        alt=""
        class="h-full w-full object-cover brightness-[0.78]"
      />
      <div class="absolute inset-0 bg-black/15"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-base-100"></div>
    </div>

    <section class="relative z-10 mx-auto mb-4 mt-8 text-center">
      <h1 class="text-4xl font-extrabold tracking-normal text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.45)] md:text-5xl">
        文章标签
      </h1>
      <p class="mt-3 text-lg font-medium text-white/95 drop-shadow-md">
        全站共计 {tagList.length} 个标签
      </p>
    </section>

    <section class="relative z-10 flex flex-1 items-center justify-center">
      <div class="relative aspect-square overflow-hidden bg-base-100/70" style="width: min(720px, calc(100vw - 2rem), calc(100vh - 14rem));">
      {tagCloud.map(({ name, count, size, x, y, delay }, index) => (
        <a 
	          href={`/tags/${name}/`}
          title={`${count} 篇文章`}
          class={`group absolute inline-flex -translate-x-1/2 -translate-y-1/2 items-baseline gap-1.5 whitespace-nowrap font-black leading-none transition-all duration-300 hover:z-20 hover:scale-110 hover:text-primary animate-fade-in no-underline ${index === 0 ? 'z-10 text-primary' : 'text-text-muted'}`}
          style={`left: ${x}%; top: ${y}%; animation-delay: ${delay}ms; font-size: clamp(14px, ${size}px, ${index === 0 ? '52px' : '36px'})`}
        >
          <span class="opacity-50">#</span>
	        <span>{name}</span>
	        <span class="text-sm font-bold opacity-45 transition-opacity group-hover:opacity-70">{count}</span>
        </a>
      ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

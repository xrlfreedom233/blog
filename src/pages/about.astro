---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';

const skills = [
  'Java / JVM',
  'Spring Boot / Spring Cloud',
  'MySQL / Redis',
  'RabbitMQ / 高并发优化',
  'Linux / Docker / Nginx',
  'JWT / Maven / Knife4j',
  '设计模式 / 并发编程',
  'AI Agent 辅助开发',
];
---

<BaseLayout title="关于我 | freedom">
  <Header />
  <Hero title="关于我" subtitle="遇事不决，可问春风；此生辽阔，不负时光。" />
  
  <main class="container mx-auto px-4 py-20 max-w-4xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- 左侧：头像与简介 -->
      <div class="md:col-span-1 text-center">
        <img 
          src="https://tuchuang.xrlfreedom.top/2026/04/19d23f3d87c7ac449c8abbe36a4edbf0.webp" 
          class="w-32 h-32 rounded-full mx-auto mb-6 ring-4 ring-primary/20 shadow-xl object-cover" 
          alt="Avatar"
        />
        <h2 class="text-2xl font-bold dark:text-white mb-2">freedom</h2>
	        <p class="text-gray-500 text-base mb-6">Java 后端开发 / Linux 折腾者</p>
        
        <div class="space-y-3">
          <a
            href="https://github.com/xrlfreedom233"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 text-left shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
          >
            <span class="flex items-center gap-3">
              <span class="icon-[tabler--brand-github] text-2xl text-gray-700 transition-colors group-hover:text-primary dark:text-gray-200"></span>
              <span>
                <span class="block text-base font-bold text-gray-800 transition-colors group-hover:text-primary dark:text-white">GitHub</span>
                <span class="block text-sm text-gray-500 dark:text-gray-400">查看代码主页</span>
              </span>
            </span>
            <span class="icon-[tabler--external-link] text-xl text-gray-400 transition-colors group-hover:text-primary"></span>
          </a>

          <a
            href="https://space.bilibili.com/631150052"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3 text-left shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
          >
            <span class="flex items-center gap-3">
              <span class="icon-[tabler--brand-bilibili] text-2xl text-pink-500 transition-colors group-hover:text-primary"></span>
              <span>
                <span class="block text-base font-bold text-gray-800 transition-colors group-hover:text-primary dark:text-white">Bilibili</span>
                <span class="block text-sm text-gray-500 dark:text-gray-400">查看视频主页</span>
              </span>
            </span>
            <span class="icon-[tabler--external-link] text-xl text-gray-400 transition-colors group-hover:text-primary"></span>
          </a>
        </div>
      </div>

      <!-- 右侧：详细介绍 -->
      <div class="md:col-span-2 space-y-12">
        <section>
          <h3 class="text-xl font-bold mb-4 dark:text-white flex items-center gap-2">
            <span class="w-1 h-6 bg-primary rounded-full"></span>
            自我介绍
          </h3>
          <p class="text-text-muted leading-relaxed">
            你好！我是 freedom，主要方向是 Java 后端开发。平时关注 Spring 生态、MySQL、Redis、RabbitMQ
            和高并发场景下的系统优化，也喜欢折腾 Linux、Docker、Nginx、NAS 与服务部署。
            我会把项目开发、问题排查、系统配置和学习过程记录在这里，让这个博客成为自己的技术笔记和长期复盘空间。
          </p>
        </section>

        <section>
          <h3 class="text-xl font-bold mb-6 dark:text-white flex items-center gap-2">
            <span class="w-1 h-6 bg-primary rounded-full"></span>
            技能清单
          </h3>
          <div class="flex flex-wrap gap-3">
            {skills.map(skill => (
              <span class="inline-flex rounded-lg border border-gray-200 bg-white px-4 py-2 text-base font-medium text-gray-600 shadow-sm transition-colors hover:border-primary hover:text-primary dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                {skill}
              </span>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

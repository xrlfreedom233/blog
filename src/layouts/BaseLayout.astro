---
interface Props {
	title?: string;
	description?: string;
}

const { title = "freedom Blog", description = "A static blog generated with Astro" } = Astro.props;

import '../styles/tailwind.css';
import '../styles/main.css';
import { ViewTransitions } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script is:inline>
			// 在首屏绘制前应用主题，避免深色/四季主题先闪一下亮色（FOUC）
			try {
				const urlTheme = new URLSearchParams(window.location.search).get('theme');
				if (urlTheme) localStorage.setItem('theme', urlTheme);
				const theme = localStorage.getItem('theme') || 'light';
				document.documentElement.setAttribute('data-theme', theme);
				if (theme === 'dark') document.documentElement.classList.add('dark');
			} catch (e) {}

			// 客户端路由切换时给 <html> 打标记，禁用入场动画，避免切页面时出现闪动。
			document.addEventListener('astro:before-swap', (e) => {
				e.newDocument?.documentElement?.classList.add('vt-nav');
			});
			document.addEventListener('astro:after-swap', () => {
				document.documentElement.classList.add('vt-nav');
			});
		</script>
		<link rel="icon" type="image/x-icon" href="https://tuchuang.xrlfreedom.top/2026/04/19d23f3d87c7ac449c8abbe36a4edbf0.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<ViewTransitions fallback="swap" />

		<!-- 正文字体（MiSans 子集）预加载，减少字体切换闪烁 -->
		<link rel="preload" as="font" type="font/woff2" href="/fonts/misans-regular.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/misans-demibold.woff2" crossorigin />

		<!-- SEO Meta Tags -->
		<link rel="canonical" href={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://tuchuang.xrlfreedom.top/2026/04/19d23f3d87c7ac449c8abbe36a4edbf0.webp" />

		<!-- RSS & Sitemap -->
		<link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		
		<script>
			import '../scripts/main.ts';
		</script>
	</head>
	<body class="bg-base-100 text-text-base text-[17px] transition-colors duration-300">
		<div id="reading-progress" class="fixed left-0 top-0 z-[70] h-1 w-0 bg-primary transition-[width] duration-150"></div>

		<slot />

		<!-- 回到顶部按钮 -->
		<button
			id="back-to-top"
			class="fixed bottom-8 right-8 z-50 grid h-14 w-14 place-items-center rounded-full bg-base-100 text-primary shadow-lg opacity-0 translate-y-10 pointer-events-none transition-all duration-300 hover:scale-110 active:scale-95 group"
			aria-label="回到顶部"
		>
			<svg class="absolute inset-0 h-14 w-14 -rotate-90" viewBox="0 0 56 56" aria-hidden="true">
				<circle cx="28" cy="28" r="24" fill="none" stroke="currentColor" stroke-width="4" class="text-primary/15"></circle>
				<circle
					id="back-to-top-progress"
					cx="28"
					cy="28"
					r="24"
					fill="none"
					stroke="currentColor"
					stroke-width="4"
					stroke-linecap="round"
					stroke-dasharray="150.8"
					stroke-dashoffset="150.8"
				></circle>
			</svg>
			<span id="back-to-top-percent" class="relative text-xs font-black">0%</span>
			<span class="absolute right-full mr-4 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-gray-800 text-white text-sm rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">回到顶部</span>
		</button>

			<script>
				// 全局脚本逻辑：阅读进度、代码复制、回到顶部
				function setupGlobalInteractions() {
					const progressBar = document.getElementById('reading-progress');
					const btt = document.getElementById('back-to-top');
					const bttProgress = document.getElementById('back-to-top-progress');
					const bttPercent = document.getElementById('back-to-top-percent');

					if ((window as any).__freedomScrollHandler) {
						window.removeEventListener('scroll', (window as any).__freedomScrollHandler);
					}

					const handleScrollProgress = () => {
						const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
						const progress = scrollHeight > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollHeight) * 100)) : 0;

						if (progressBar) {
							progressBar.style.width = `${progress}%`;
						}

						if (btt) {
							if (window.scrollY > 400) {
								btt.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
							} else {
								btt.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
							}
						}

						if (bttProgress) {
							const circumference = 150.8;
							bttProgress.style.strokeDashoffset = String(circumference - (progress / 100) * circumference);
						}

						if (bttPercent) {
							bttPercent.textContent = `${Math.round(progress)}%`;
						}
					};

					(window as any).__freedomScrollHandler = handleScrollProgress;
					window.addEventListener('scroll', handleScrollProgress);
					handleScrollProgress();

					if (btt) {
						btt.onclick = () => {
							window.scrollTo({ top: 0, behavior: 'smooth' });
						};
					}

					// 2. 代码块一键复制
					let blocks = document.querySelectorAll('pre');
					blocks.forEach((block) => {
						const code = block.querySelector('code');
						const languageClass = Array.from(code?.classList || []).find((className) => className.startsWith('language-'));
						const language = languageClass?.replace('language-', '');

						if (language && !block.querySelector('.code-language-label')) {
							const label = document.createElement('span');
							label.innerText = language;
							label.className = 'code-language-label';
							block.appendChild(label);
						}

						if (navigator.clipboard && !block.querySelector('.copy-code-button')) {
							let button = document.createElement('button');
							button.innerText = '复制';
							button.className = 'copy-code-button';
						block.appendChild(button);

						button.addEventListener('click', async () => {
							let code = block.querySelector('code');
							let text = code?.innerText || '';
							await navigator.clipboard.writeText(text);
							button.innerText = '已复制!';
							setTimeout(() => {
								button.innerText = '复制';
							}, 2000);
						});
					}
				});
			}

			// 适配 ViewTransitions
			document.addEventListener('astro:page-load', setupGlobalInteractions);
		</script>

		<style is:global>
			/* 代码复制按钮样式 */
			pre {
				position: relative;
			}
			.copy-code-button {
				position: absolute;
				top: 0.5rem;
				right: 0.5rem;
				padding: 0.25rem 0.5rem;
				font-size: 0.875rem;
				color: #9ca3af;
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 0.375rem;
				cursor: pointer;
				opacity: 0;
				transition: all 0.2s;
			}
			pre:hover .copy-code-button {
				opacity: 1;
			}
			.copy-code-button:hover {
				background: rgba(255, 255, 255, 0.2);
				color: #fff;
			}
			.code-language-label {
				position: absolute;
				top: 0.5rem;
				left: 0.75rem;
				padding: 0.2rem 0.55rem;
				font-size: 0.75rem;
				font-weight: 700;
				color: #d1d5db;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 0.375rem;
				text-transform: uppercase;
			}
		</style>
	</body>
</html>

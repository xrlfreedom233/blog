---
import Stats from './Stats.astro';
---

<div class="bg-base-100 p-6 rounded-2xl shadow-sm border border-border-base animate-fade-in text-center group">
    <!-- 头像区 -->
    <a href="/about/" class="relative inline-block mb-6">
        <!-- 渐变光晕外圈 (粉红 -> 紫 -> 青色) -->
        <div class="absolute inset-[-6px] rounded-full bg-gradient-to-tr from-rose-400 via-purple-400 to-cyan-400 animate-spin-slow"></div>
        <!-- 间隔层 (3px) -->
        <div class="absolute inset-[-3px] rounded-full bg-base-100"></div>
        <!-- 核心头像 -->
        <img 
            src="https://tuchuang.xrlfreedom.top/2026/04/19d23f3d87c7ac449c8abbe36a4edbf0.webp" 
            class="relative w-24 h-24 rounded-full object-cover shadow-sm transition-transform duration-500 group-hover:scale-105" 
            alt="Avatar" 
        />
    </a>

    <!-- 博客标题 (Freedom Blog) -->
    <h3 class="font-serif text-[22px] font-black text-text-base mb-6 tracking-tight leading-none">Freedom Blog</h3>

    <!-- 统计数据区 (注入 Stats 组件) -->
    <Stats />
</div>

<style>
	@keyframes spin-slow {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}
	.animate-spin-slow {
		animation: spin-slow 8s linear infinite;
	}
</style>

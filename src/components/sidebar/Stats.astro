---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const postCount = allPosts.length;

const categories = new Set();
const tags = new Set();
allPosts.forEach(post => {
    post.data.categories?.forEach(c => categories.add(c));
    post.data.tags?.forEach(t => tags.add(t));
});

const stats = [
    { label: '文章', value: postCount, color: 'text-sky-500 dark:text-sky-300', href: '/archives/' },
    { label: '分类', value: categories.size, color: 'text-green-500 dark:text-green-300', href: '/categories/' },
    { label: '标签', value: tags.size, color: 'text-rose-500 dark:text-rose-300', href: '/tags/' },
];
---

<div class="grid grid-cols-3 gap-3">
    {stats.map(stat => (
        <a href={stat.href} class="flex flex-col items-center py-3 bg-base-200/60 rounded-xl border border-border-base/60 shadow-sm transition-all hover:bg-base-200 hover:border-border-base hover:-translate-y-1 group/stat">
	            <span class={`text-2xl font-black ${stat.color} leading-none mb-1 drop-shadow-sm transition-transform group-hover/stat:scale-110`}>{stat.value}</span>
	            <span class="text-base text-text-muted font-bold">{stat.label}</span>
        </a>
    ))}
</div>

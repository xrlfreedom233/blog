---
const currentYear = new Date().getFullYear();
const footerConfig = {
	animalImage: "/images/animals.webp",
	slogan: "愿你眼中总有光，活成自己喜欢的模样",
	icp: "蜀ICP备2024106195号-1",
	icpLink: "https://beian.miit.gov.cn/",
	author: "freedom",
	startTime: "2024-06-19T00:00:00+08:00"
};
---

<div class="relative mt-20">
	<!-- 动物装饰图 - 刚好贴合底边水平线（双手趴在底边） -->
	<div class="fixed bottom-0 left-0 w-full z-30 pointer-events-none select-none">
		<div class="flex justify-center w-full">
			<div id="animal-dock" class="animal-dock pointer-events-auto cursor-pointer drop-shadow-sm">
				<img
					src={footerConfig.animalImage}
					alt="动物装饰"
					width="1200"
					height="145"
					decoding="async"
					class="h-16 md:h-20 w-auto max-w-full object-contain object-bottom opacity-100"
				/>
			</div>
		</div>
	</div>

	<footer class="relative z-20 bg-base-100/80 dark:bg-base-100/80 border-t border-border-base pt-12 pb-24 md:pb-28 backdrop-blur-md mt-16">
		<div class="container mx-auto px-4">
			<!-- 个性化标语 -->
			<div class="mb-8 text-center">
				<p class="bg-gradient-to-r from-teal-700 to-blue-700 bg-clip-text text-lg font-medium italic text-transparent dark:from-teal-300 dark:to-blue-300">
					{footerConfig.slogan}
				</p>
			</div>

			<div class="flex flex-col items-center space-y-4 text-base text-gray-500 dark:text-gray-400">
				<div class="flex flex-wrap justify-center gap-6">
					<a href={footerConfig.icpLink} target="_blank" class="hover:text-primary transition-colors">
						{footerConfig.icp}
					</a>
					<span>
						本站已运行
						<span
							id="site-runtime"
							class="font-bold text-primary-ink"
							data-start-time={footerConfig.startTime}
						>
							计算中...
						</span>
					</span>
					<span>&copy; {currentYear} {footerConfig.author}</span>
					<div class="flex items-center space-x-1">
						<span>Powered by</span>
						<a href="https://astro.build" target="_blank" class="font-bold hover:text-primary transition-colors">Astro</a>
					</div>
					<a href="/rss.xml" class="font-bold hover:text-primary transition-colors">RSS</a>
					<a href="/sitemap-index.xml" class="font-bold hover:text-primary transition-colors">Sitemap</a>
				</div>
			</div>
		</div>
	</footer>
</div>

<script>
	function setupSiteRuntime() {
		const runtime = document.getElementById('site-runtime');
		if (!runtime) return;

		const startTime = new Date(runtime.dataset.startTime || '').getTime();
		if (Number.isNaN(startTime)) {
			runtime.textContent = '时间配置错误';
			return;
		}

		if ((window as any).__freedomRuntimeTimer) {
			window.clearInterval((window as any).__freedomRuntimeTimer);
		}

		const updateRuntime = () => {
			const diffSeconds = Math.max(0, Math.floor((Date.now() - startTime) / 1000));
			const days = Math.floor(diffSeconds / 86400);
			const hours = Math.floor((diffSeconds % 86400) / 3600);
			const minutes = Math.floor((diffSeconds % 3600) / 60);
			const seconds = diffSeconds % 60;

			runtime.textContent = `${days} 天 ${hours} 时 ${minutes} 分 ${seconds} 秒`;
		};

		updateRuntime();
		(window as any).__freedomRuntimeTimer = window.setInterval(updateRuntime, 1000);
	}

	function setupAnimalDock() {
		const dock = document.getElementById('animal-dock');
		if (!dock) return;

		const handleScroll = () => {
			const scrollDistanceToBottom = document.documentElement.scrollHeight - (window.innerHeight + window.scrollY);
			// 触底判定：当滚动离页面最底部在 120px 以内时触发露出双手
			if (scrollDistanceToBottom <= 120) {
				dock.classList.add('at-bottom');
			} else {
				dock.classList.remove('at-bottom');
			}
		};

		if ((window as any).__freedomAnimalScrollHandler) {
			window.removeEventListener('scroll', (window as any).__freedomAnimalScrollHandler);
		}
		(window as any).__freedomAnimalScrollHandler = handleScroll;
		window.addEventListener('scroll', handleScroll, { passive: true });
		handleScroll();
	}

	// 初始加载及 ViewTransitions 页面切换时均进行挂载
	setupAnimalDock();
	document.addEventListener('astro:page-load', () => {
		setupSiteRuntime();
		setupAnimalDock();
	});
</script>

<style>
	.animal-dock {
		transform: translateY(28%);
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
		will-change: transform;
	}

	.animal-dock:hover,
	.animal-dock.at-bottom {
		transform: translateY(8%);
	}
</style>

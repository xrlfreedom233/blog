---
import type { CollectionEntry } from 'astro:content';
import readingTime from 'reading-time';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, tags, categories } = post.data;
const stats = readingTime(post.body);
---

<article class="group">
	<div class="post-card-shell rounded-xl overflow-hidden relative block cursor-pointer border transition-all duration-300 hover:scale-[1.01] bg-base-100">
		<a href={`/blog/${post.slug}`} class="p-7 md:p-9 block">
			<div class="flex flex-col h-full">
				<!-- 标题 -->
				<h2 class="mb-5 text-2xl md:text-[1.7rem] font-bold text-text-base transition-colors group-hover:text-primary leading-snug">
					{title}
				</h2>

				<!-- 整合后的信息行 (日期 | 阅读时间 | 分类) -->
				<div class="flex flex-wrap items-center gap-y-2 text-base font-bold text-text-muted/60 uppercase tracking-wider">
					<!-- 日期 -->
					<div class="flex items-center gap-1.5 mr-4">
						<span class="icon-[tabler--calendar] w-4 h-4 opacity-60"></span>
						<time>{pubDate.toLocaleDateString('zh-CN')}</time>
					</div>

					<!-- 阅读时间 -->
					<div class="flex items-center gap-1.5 mr-4">
						<span class="icon-[tabler--clock] w-4 h-4 opacity-60"></span>
						<span>{Math.ceil(stats.minutes)} 分钟阅读</span>
					</div>

					<!-- 分类 -->
					{categories && categories.length > 0 && (
						<div class="flex items-center gap-1.5 px-2.5 py-1 bg-primary/5 text-primary/70 rounded-md">
							<span class="icon-[tabler--folder] w-4 h-4"></span>
							<span>{categories[0]}</span>
						</div>
					)}
				</div>
			</div>

			<!-- 底部装饰线 -->
			<div class="absolute bottom-0 left-0 h-0.5 w-0 bg-primary transition-all duration-500 group-hover:w-full"></div>
		</a>
	</div>
</article>

<style>
	.post-card-shell {
		border-color: rgba(148, 163, 184, 0.42);
		box-shadow:
			0 10px 26px rgba(15, 23, 42, 0.08),
			0 1px 2px rgba(15, 23, 42, 0.08);
	}

	.post-card-shell:hover {
		border-color: rgba(99, 102, 241, 0.38);
		box-shadow:
			0 16px 34px rgba(15, 23, 42, 0.12),
			0 2px 6px rgba(99, 102, 241, 0.12);
	}

	:global(.dark) .post-card-shell,
	:global([data-theme="dark"]) .post-card-shell {
		border-color: var(--border-base);
		box-shadow: 0 1px 2px var(--shadow-sm);
	}
</style>
